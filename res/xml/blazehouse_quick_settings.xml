<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/quick_settings_title">

    <PreferenceCategory
        android:title="@string/quick_settings_interface_category">

        <lineageos.preference.LineageSystemSettingListPreference
            android:key="qs_quick_pulldown"
            android:title="@string/status_bar_quick_qs_pulldown_title"
            android:entries="@array/status_bar_quick_qs_pulldown_entries"
            android:entryValues="@array/status_bar_quick_qs_pulldown_values"
            android:defaultValue="0" />

        <Preference
            android:key="qs_header_image"
            android:title="@string/quick_settings_header_image_title"
            android:summary="@string/quick_settings_header_image_summary"
            android:fragment="org.evolution.settings.fragments.quicksettings.QsHeaderImageSettings" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="media_waveform_seekbar"
            android:title="@string/media_waveform_seekbar_title"
            android:summary="@string/media_waveform_seekbar_summary"
            android:defaultValue="false" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="qs_compact_media_player_mode"
            android:title="@string/qs_compact_media_player_mode_title"
            android:summary="@string/qs_compact_media_player_mode_summary"
            android:defaultValue="false" />

    </PreferenceCategory>


    <PreferenceCategory
        android:title="@string/status_bar_brightness_category">

        <lineageos.preference.LineageSecureSettingListPreference
            android:key="qs_show_brightness_slider"
            android:title="@string/status_bar_brightness_slider_title"
            android:dialogTitle="@string/status_bar_brightness_slider_title"
            android:entries="@array/status_bar_brightness_slider_entries"
            android:entryValues="@array/status_bar_brightness_slider_values"
            android:defaultValue="1" />

        <lineageos.preference.LineageSecureSettingListPreference
            android:key="qs_brightness_slider_position"
            android:title="@string/status_bar_brightness_slider_position_title"
            android:dialogTitle="@string/status_bar_brightness_slider_position_title"
            android:entries="@array/status_bar_brightness_slider_position_entries"
            android:entryValues="@array/status_bar_brightness_slider_position_values"
            android:defaultValue="0"
            android:dependency="qs_show_brightness_slider" />

        <lineageos.preference.LineageSecureSettingSwitchPreference
            android:key="qs_show_auto_brightness"
            android:title="@string/status_bar_brightness_slider_auto_title"
            android:summary="@string/status_bar_brightness_slider_auto_summary"
            android:defaultValue="true"
            android:dependency="qs_show_brightness_slider" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="qs_brightness_slider_haptic"
            android:title="@string/quick_settings_brightness_slider_haptic_title"
            android:summary="@string/quick_settings_brightness_slider_haptic_summary"
            android:defaultValue="true"
            android:dependency="qs_show_brightness_slider" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/quick_settings_tiles_category">

        <com.blaze.house.preferences.SystemSettingListPreference
            android:key="qs_tile_shape"
            android:title="@string/quick_settings_tile_shape_title"
            android:entries="@array/quick_settings_tile_shape_entries"
            android:entryValues="@array/quick_settings_tile_shape_values"
            android:defaultValue="0" />

        <com.blaze.house.preferences.QSTileIconShapePreference
            android:key="qs_tile_icon_shape"
            android:title="@string/quick_settings_tile_icon_shape_title" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="qs_tile_haptic"
            android:title="@string/quick_settings_tile_haptic_title"
            android:summary="@string/quick_settings_tile_haptic_summary"
            android:defaultValue="true" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="qs_tile_label_hide"
            android:title="@string/quick_settings_tile_label_hide_title"
            android:summary="@string/quick_settings_tile_label_hide_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/quick_settings_layout_columns_rows_title">

        <com.blaze.house.preferences.SystemSettingSeekBarPreference
            android:key="qs_columns_portrait"
            android:title="@string/quick_settings_columns_portrait_title"
            android:defaultValue="2"
            android:max="6"
            settings:min="2" />

        <com.blaze.house.preferences.SystemSettingSeekBarPreference
            android:key="qs_columns_landscape"
            android:title="@string/quick_settings_columns_landscape_title"
            android:defaultValue="4"
            android:max="8"
            settings:min="2" />

        <com.blaze.house.preferences.SystemSettingSeekBarPreference
            android:key="qs_rows_portrait"
            android:title="@string/quick_settings_rows_portrait_title"
            android:defaultValue="4"
            android:max="6"
            settings:min="2" />

        <com.blaze.house.preferences.SystemSettingSeekBarPreference
            android:key="qs_rows_landscape"
            android:title="@string/quick_settings_rows_landscape_title"
            android:defaultValue="2"
            android:max="4"
            settings:min="1" />

        <com.blaze.house.preferences.SystemSettingSeekBarPreference
            android:key="qqs_rows_portrait"
            android:title="@string/quick_settings_qqs_rows_portrait_title"
            android:defaultValue="2"
            android:max="3"
            settings:min="1" />

        <com.blaze.house.preferences.SystemSettingSeekBarPreference
            android:key="qqs_rows_landscape"
            android:title="@string/quick_settings_qqs_rows_landscape_title"
            android:defaultValue="1"
            android:max="3"
            settings:min="1" />

    </PreferenceCategory>
</PreferenceScreen>
