<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/lock_screen_title">

    <PreferenceCategory
        android:title="@string/lockscreen_styles_category">

        <Preference
            android:key="pixel_lockscreen_clock_style"
            android:title="Pixel Lock Screen Clocks"
            android:summary="Choose official Google Pixel clock styles, color palettes and sizes">
            <intent
                android:action="android.intent.action.SET_WALLPAPER"
                android:targetPackage="com.android.wallpaper"
                android:targetClass="com.android.customization.picker.CustomizationPickerActivity" />
        </Preference>

        <Preference
            android:key="lockscreen_custom_clock_style"
            android:title="BlazeHouse Clock Styles (90+ Designs)"
            android:summary="Custom digital &amp; analog lock screen clock designs with font and color customization"
            android:fragment="org.evolution.settings.fragments.lockscreen.CustomClockPreview" />

        <Preference
            android:key="lockscreen_widgets_settings"
            android:title="@string/lockscreen_widgets_title"
            android:summary="@string/lockscreen_widgets_enabled_summary"
            android:fragment="org.evolution.settings.fragments.lockscreen.LockScreenWidgets" />

        <Preference
            android:key="depth_wallpaper_settings"
            android:title="@string/depthwall_wallpaper_enabled_title"
            android:summary="@string/depthwall_wallpaper_enabled_summary"
            android:fragment="org.evolution.settings.fragments.lockscreen.WallpaperDepth" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/lock_screen_media_category">

        <Preference
            android:key="nowplaying_settings"
            android:title="@string/nowplaying_title"
            android:summary="@string/nowplaying_summary"
            android:fragment="org.evolution.settings.fragments.lockscreen.NowPlayingSettings" />

        <Preference
            android:key="edge_light_settings"
            android:title="@string/edge_light_title"
            android:summary="@string/edge_light_summary"
            android:fragment="org.evolution.settings.fragments.lockscreen.EdgeLightSettings" />

        <Preference
            android:key="media_art_settings"
            android:title="@string/ls_media_art_title"
            android:summary="@string/ls_media_art_summary"
            android:fragment="org.evolution.settings.fragments.lockscreen.MediaArtSettings" />

        <Preference
            android:key="pulse_settings"
            android:title="@string/pulse_settings_title"
            android:summary="@string/pulse_settings_summary"
            android:fragment="org.evolution.settings.fragments.lockscreen.PulseSettings" />

        <Preference
            android:key="charging_animation_settings"
            android:title="@string/charging_animation_title"
            android:summary="@string/charging_animation_summary"
            android:fragment="org.evolution.settings.fragments.lockscreen.ChargingAnimationSettings" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/lock_screen_gestures_category">

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_battery_info"
            android:title="@string/lockscreen_battery_info_title"
            android:summary="@string/lockscreen_battery_info_summary"
            android:defaultValue="true" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="double_tap_sleep_lockscreen"
            android:title="@string/lockscreen_double_tap_to_sleep_title"
            android:summary="@string/lockscreen_double_tap_to_sleep_summary"
            android:defaultValue="true" />

        <com.blaze.house.preferences.LineageSystemSettingSwitchPreference
            android:key="proximity_on_wake"
            android:title="@string/proximity_on_wake_title"
            android:summary="@string/proximity_on_wake_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/app_lock_title">

        <Preference
            android:key="app_lock"
            android:title="@string/app_lock_title"
            android:summary="@string/app_lock_summary"
            android:fragment="com.android.settings.security.applock.AppLockSettingsFragment" />

    </PreferenceCategory>

</PreferenceScreen>
