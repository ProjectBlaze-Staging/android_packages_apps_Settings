<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/miscellaneous_title">

    <!-- Haptic feedback on gesture -->
    <PreferenceCategory
        android:title="@string/haptic_feedback_title">

        <Preference
            android:key="blaze_goodlock_studio_sys_entry"
            android:icon="@drawable/ic_settings_system_dashboard_filled"
            android:title="Home Up ve Modüler Sistem Stüdyosu"
            android:summary="Launcher3 yaylanma fiziği, Pop-up klasör, Task Changer, bağımsız ses mikseri, çoklu pencere ve etkinlik günlüğü"
            android:fragment="com.blaze.house.fragments.BlazeGoodLockStudioFragment" />

        <Preference
            android:key="blaze_ohaptics_engine_selector"
            android:icon="@drawable/ic_settings_gestures"
            android:title="Dokunsal Geri Bildirim Profili"
            android:summary="Keskin mekanik, yumuşak kadife veya standart dokunma titreşim tepkisi" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="haptic_feedback_enabled"
            android:title="@string/haptic_feedback_title"
            android:summary="@string/haptic_feedback_summary"
            android:defaultValue="true" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="qs_tile_haptic"
            android:title="@string/quick_settings_tile_haptic_title"
            android:summary="@string/quick_settings_tile_haptic_summary"
            android:defaultValue="true" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="qs_brightness_slider_haptic"
            android:title="@string/quick_settings_brightness_slider_haptic_title"
            android:summary="@string/quick_settings_brightness_slider_haptic_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <!-- LMO Freeform Windowing & Multitasking -->
    <PreferenceCategory
        android:title="@string/freeform_category_title">

        <com.blaze.house.preferences.GlobalSettingSwitchPreference
            android:key="lmo_freeform_enabled"
            android:title="@string/freeform_multitasking_title"
            android:summary="@string/freeform_multitasking_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <!-- Blaze Game Space & Performance -->
    <PreferenceCategory
        android:title="@string/gamespace_title">

        <Preference
            android:key="blaze_gamespace_entry"
            android:title="@string/gamespace_title"
            android:summary="@string/gamespace_summary"
            android:fragment="com.blaze.house.fragments.GameSpaceSettings" />

        <com.blaze.house.preferences.GlobalSettingSwitchPreference
            android:key="game_props_unlimited_fps"
            android:title="@string/games_fps_spoof_title"
            android:summary="@string/games_fps_spoof_summary"
            android:defaultValue="true" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="gamespace_show_fps"
            android:title="@string/gamespace_fps_title"
            android:summary="@string/gamespace_fps_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- Power Menu & Advanced Reboot -->
    <PreferenceCategory
        android:title="@string/power_menu_title">

        <lineageos.preference.LineageSecureSettingSwitchPreference
            android:key="advanced_reboot"
            android:title="@string/advanced_reboot_title"
            android:summary="@string/advanced_reboot_summary"
            android:defaultValue="true" />

        <Preference
            android:key="power_menu_actions"
            android:title="@string/power_menu_items_title"
            android:summary="@string/power_menu_items_summary"
            android:fragment="org.evolution.settings.fragments.powermenu.PowerMenuActions" />

    </PreferenceCategory>

    <!-- Battery & Performance -->
    <PreferenceCategory
        android:title="@string/battery_performance_title">

        <Preference
            android:key="blaze_battery_health_studio"
            android:icon="@drawable/ic_settings_battery_filled"
            android:title="Pil Sağlığı, Döngü Sayısı ve Şarj Koruması"
            android:summary="Gerçek pil kapasitesi (mAh), şarj döngüsü, anlık güç/sıcaklık verileri ve akıllı şarj koruma kademeleri"
            android:fragment="com.blaze.house.fragments.BlazeBatteryHealthStudioFragment" />

        <com.blaze.house.preferences.GlobalSettingSwitchPreference
            android:key="aggressive_doze"
            android:title="@string/aggressive_doze_title"
            android:summary="@string/aggressive_doze_summary"
            android:defaultValue="true" />

        <com.blaze.house.preferences.SystemSettingSwitchPreference
            android:key="charging_control_enabled"
            android:title="@string/charging_control_title"
            android:summary="@string/charging_control_summary"
            android:defaultValue="false" />

        <com.blaze.house.preferences.SystemSettingListPreference
            android:key="charging_control_limit"
            android:title="@string/charging_control_limit_title"
            android:entries="@array/charging_control_limit_entries"
            android:entryValues="@array/charging_control_limit_values"
            android:defaultValue="80"
            android:dependency="charging_control_enabled" />

        <Preference
            android:key="smart_pixels_settings"
            android:title="@string/smart_pixels_title"
            android:summary="@string/smart_pixels_summary"
            android:fragment="org.evolution.settings.fragments.miscellaneous.SmartPixels" />

    </PreferenceCategory>

    <!-- Volume Settings -->
    <PreferenceCategory
        android:title="@string/volume_settings_title">

        <Preference
            android:key="blaze_dolby_atmos_entry"
            android:title="@string/blaze_dolby_atmos_title"
            android:summary="@string/blaze_dolby_atmos_summary">
            <intent
                android:action="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL"
                android:targetPackage="org.lineageos.audiofx"
                android:targetClass="org.lineageos.audiofx.activity.ActivityMusic" />
        </Preference>

        <com.blaze.house.preferences.LineageSystemSettingSwitchPreference
            android:key="volbtn_music_controls"
            android:title="@string/volbtn_music_controls_title"
            android:summary="@string/volbtn_music_controls_summary"
            android:defaultValue="true" />

        <com.blaze.house.preferences.LineageSystemSettingSwitchPreference
            android:key="volume_wake_screen"
            android:title="@string/volume_wake_screen_title"
            android:summary="@string/volume_wake_screen_summary"
            android:defaultValue="false" />

        <com.blaze.house.preferences.LineageSystemSettingSwitchPreference
            android:key="torch_long_press_power_gesture"
            android:title="@string/torch_long_press_power_gesture_title"
            android:summary="@string/torch_long_press_power_gesture_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- Spoofing Options -->
    <PreferenceCategory
        android:title="@string/spoofing_title">

        <Preference
            android:key="spoofing_settings"
            android:title="@string/spoofing_title"
            android:summary="@string/spoofing_summary"
            android:fragment="org.evolution.settings.fragments.miscellaneous.Spoofing" />

    </PreferenceCategory>

    <!-- Screen Security & Protections -->
    <PreferenceCategory
        android:title="@string/miscellaneous_screen_capture_category">

        <com.blaze.house.preferences.GlobalSettingSwitchPreference
            android:key="window_ignore_secure"
            android:title="@string/window_ignore_secure_title"
            android:summary="@string/window_ignore_secure_summary"
            android:defaultValue="false" />

        <com.blaze.house.preferences.GlobalSettingSwitchPreference
            android:key="window_block_screenshot_detection"
            android:title="@string/window_block_screenshot_detection_title"
            android:summary="@string/window_block_screenshot_detection_summary"
            android:defaultValue="false" />

        <com.blaze.house.preferences.GlobalSettingSwitchPreference
            android:key="window_block_screenrecord_detection"
            android:title="@string/window_block_screenrecord_detection_title"
            android:summary="@string/window_block_screenrecord_detection_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <!-- System & App Compatibility -->
    <PreferenceCategory
        android:title="@string/miscellaneous_system_bypass_category">

        <com.blaze.house.preferences.GlobalSettingSwitchPreference
            android:key="bypass_low_target_sdk_block"
            android:title="@string/bypass_low_target_sdk_block_title"
            android:summary="@string/bypass_low_target_sdk_block_summary"
            android:defaultValue="true" />

        <com.blaze.house.preferences.GlobalSettingSwitchPreference
            android:key="netflix_spoof"
            android:title="@string/netflix_spoof_title"
            android:summary="@string/netflix_spoof_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

</PreferenceScreen>
