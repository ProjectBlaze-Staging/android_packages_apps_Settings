<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/account_back_btn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="?android:attr/textColorPrimary"
            android:contentDescription="@android:string/cancel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/blaze_account_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="32dp"
            android:gravity="center_horizontal">

            <!-- Circular Avatar Container -->
            <FrameLayout
                android:id="@+id/avatar_container"
                android:layout_width="118dp"
                android:layout_height="118dp"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="118dp"
                    android:layout_height="118dp"
                    android:background="@drawable/blaze_avatar_circle_bg"
                    android:padding="3dp"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/account_avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_blaze_account_avatar"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <!-- Camera Edit Badge -->
                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/blaze_avatar_circle_bg"
                    android:elevation="4dp"
                    android:padding="7dp"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="?android:attr/colorAccent"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/btn_change_photo_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="6dp"
                android:text="@string/blaze_account_change_photo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?android:attr/colorAccent" />

            <!-- 1. Username (Used in Settings Header Greeting: "Good morning <Username>,") -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:text="@string/blaze_account_username_label"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_account_username"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/blaze_account_input_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:hint="@string/blaze_account_username_hint"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorTertiary"
                android:textSize="16sp"
                android:inputType="textPersonName"
                android:singleLine="true"
                android:maxLines="1" />

            <!-- 2. Real Name (Full Name) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:text="@string/blaze_account_name_label"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_account_name"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/blaze_account_input_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:hint="@string/blaze_account_name_hint"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorTertiary"
                android:textSize="16sp"
                android:inputType="textPersonName|textCapWords"
                android:singleLine="true"
                android:maxLines="1" />

            <!-- 3. Personal Greeting Motto (Default: "Another day to live!") -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="6dp"
                android:text="@string/blaze_account_motto_label"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_account_phone"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/blaze_account_input_bg"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:hint="Another day to live!"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorTertiary"
                android:textSize="16sp"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:maxLines="1" />

            <!-- Offline Status Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/blaze_specs_card_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/blaze_account_offline"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/blaze_account_status"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Save Button -->
            <TextView
                android:id="@+id/btn_save_account"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/blaze_account_primary_btn_bg"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:text="@string/blaze_account_save"
                android:textColor="?android:attr/textColorPrimaryInverse"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Delete Account Button -->
            <TextView
                android:id="@+id/btn_delete_account"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/blaze_account_delete"
                android:textColor="#FFFF5252"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
