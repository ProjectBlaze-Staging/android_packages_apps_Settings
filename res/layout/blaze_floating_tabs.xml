<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/blaze_tab_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/blaze_floating_tab_bar_bg"
        android:elevation="4dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Tab 0: Themes -->
        <LinearLayout
            android:id="@+id/tab_themes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_themes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_themes_category"
                android:contentDescription="@string/themes_title" />

            <TextView
                android:id="@+id/text_themes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/themes_title"
                android:textColor="@color/blaze_tab_selected_text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tab 1: Quick Settings -->
        <LinearLayout
            android:id="@+id/tab_qs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_qs"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_notifications_panel_category"
                android:contentDescription="@string/quick_settings_title" />

            <TextView
                android:id="@+id/text_qs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/quick_settings_title"
                android:textColor="@color/blaze_tab_selected_text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tab 2: Status Bar -->
        <LinearLayout
            android:id="@+id/tab_statusbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_statusbar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_status_bar_category"
                android:contentDescription="@string/status_bar_title" />

            <TextView
                android:id="@+id/text_statusbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/status_bar_title"
                android:textColor="@color/blaze_tab_selected_text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tab 3: Lock Screen -->
        <LinearLayout
            android:id="@+id/tab_lockscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_lockscreen"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_lockscreen_category"
                android:contentDescription="@string/lock_screen_title" />

            <TextView
                android:id="@+id/text_lockscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/lock_screen_title"
                android:textColor="@color/blaze_tab_selected_text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tab 4: System -->
        <LinearLayout
            android:id="@+id/tab_system"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/icon_system"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_system_category"
                android:contentDescription="System" />

            <TextView
                android:id="@+id/text_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="System"
                android:textColor="@color/blaze_tab_selected_text_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
