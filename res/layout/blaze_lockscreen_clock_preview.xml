<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/blaze_lockscreen_preview_bg"
        android:clipToOutline="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Date -->
            <TextView
                android:id="@+id/blaze_lockscreen_preview_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monday, September 09"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <!-- Big iOS Stencil Clock with Flame center -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/blaze_lockscreen_preview_clock_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03"
                    android:textColor="#FFFFFF"
                    android:textSize="70sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="6" />

                <!-- Center flame emblem -->
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_blaze_flame"
                    android:tint="#FFEA580C"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/blaze_lockscreen_preview_clock_minute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="37"
                    android:textColor="#FFFFFF"
                    android:textSize="70sp"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="6" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
