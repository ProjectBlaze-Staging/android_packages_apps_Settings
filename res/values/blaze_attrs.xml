<resources>
    <declare-styleable name="CustomSeekBarPreference">
        <attr name="defaultValueText" format="string" />
        <attr name="interval" format="integer" />
        <attr name="showSign" format="boolean" />
        <attr name="units" format="string|reference" />
        <attr name="continuousUpdates" format="boolean" />
    </declare-styleable>

    <!-- Base attributes available to DeviceConfigSwitchPreference. -->
    <declare-styleable name="DeviceConfigSwitchPreference">
        <attr name="deviceConfigNamespace" format="string" />
        <attr name="deviceConfigFlag" format="string" />
        <attr name="deviceConfigDefault" format="boolean" />
    </declare-styleable>
</resources>
